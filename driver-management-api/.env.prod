# Production Environment Configuration
# Copy this file to .env and update with your production values

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./driver_management_prod.db
# For PostgreSQL production:
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/driver_management

# Redis Configuration (Optional - for production)
# REDIS_URL=redis://localhost:6379/0

# Security Configuration
SECRET_KEY=your-very-secure-secret-key-change-this-in-production-minimum-32-characters
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://traetraeprojectshsqb.vercel.app

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security Settings
BCRYPT_ROUNDS=12
CSRF_SECRET_KEY=your-csrf-secret-key-change-this-in-production